---
import SocialImage from "../components/SocialImage.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import MobileMenu from "../components/mobile-menu.astro";
interface Props {
	title: string;
	description: string;
	active?: "home" | "start";
}
const { title, description, active } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={process.env.VERCEL_ENV === "production" ? "index, follow" : "noindex, nofollow"} />
{Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
		<meta name="theme-color" content="#f7f4ed" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<SocialImage />
		<meta property="og:type" content="website" />
		<link rel="icon" href="/assets/mark.svg" type="image/svg+xml" />
		<link rel="stylesheet" href="/styles.css" />
		<link rel="stylesheet" href="/layout.css" />
		<link rel="stylesheet" href="/responsive.css" />
		<link rel="stylesheet" href="/navigation.css" />
		<script is:inline src="/navigation.js" defer></script>
		<script is:inline src="/main.js" defer></script>
		<slot name="head" />
	</head>
	<body id="top">
		<a class="skip" href="#main">Skip to content</a>
		<Header active={active} />
		<slot />
		<Footer />
		<MobileMenu />
	</body>
</html>
