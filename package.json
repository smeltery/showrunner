{
	"name": "@smeltery/showrunner",
	"version": "0.1.0",
	"private": true,
	"description": "Make your pull request worth watching. Website-agnostic Playwright demos.",
	"license": "LicenseRef-PolyForm-Shield-1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/smeltery/showrunner.git"
	},
	"files": [
		"dist",
		"docs",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"type-check": "tsc --noEmit",
		"demo": "playwright test --project=demo",
		"test:agent": "playwright test --project=verification --reporter=line",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt . --check",
		"check:docs": "bash scripts/check-docs.sh",
		"check:hygiene": "bash scripts/check-hygiene.sh",
		"check:node": "bash scripts/check-node.sh",
		"check:whitespace": "bash scripts/check-whitespace.sh"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "^26.6.1",
		"oxfmt": "0.69.0",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@playwright/test": "^1.63.0"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.13.1"
}
