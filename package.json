{
	"name": "@smeltery/showrunner",
	"version": "0.1.0",
	"private": true,
	"description": "Make your pull request worth watching. Website-agnostic Playwright demos.",
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"type-check": "tsc --noEmit",
		"demo": "playwright test --project=demo",
		"test:agent": "playwright test --project=verification --reporter=line",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt . --check"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "^24.0.0",
		"oxfmt": "0.69.0",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@playwright/test": "^1.63.0"
	}
}
