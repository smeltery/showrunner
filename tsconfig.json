{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"declaration": true,
		"outDir": "dist",
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "examples/**/*.ts", "playwright.config.ts"]
}
